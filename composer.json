{
	"name": "drago-ex/project-account",
	"description": "Account management for Drago Project.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^4.0",
		"drago-ex/component": "^3.0",
		"drago-ex/project-auth": "^1.0"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the frontend permission provider."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"allow-library-install": true,
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			},
			"commands": [
				"bin/create-account-permission"
			]
		},
		"drago-translator": {
			"translation": "app/Presentation/Account/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
