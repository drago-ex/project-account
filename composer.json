{
	"name": "drago-ex/project-account",
	"description": "Account management for Drago Project.",
	"type": "drago-tools-resource",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/component": "^2.0",
		"drago-ex/project-auth": "^2.0"
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"bin": ["bin/create-account-permission"],
	"scripts": {
		"phpstan": "phpstan analyse",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	},
	"extra": {
		"drago-tools": {
			"allow-library-install": true,
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Account/Translate"
		}
	}
}
